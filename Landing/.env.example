# ─────────────────────────────────────────────────────────────────
# MercadoPago Credentials
# ─────────────────────────────────────────────────────────────────

# Access Token de prueba (test) o producción.
# Obtenerlo en: https://www.mercadopago.com.ar/developers/panel/app
# ¡NUNCA exponer en el frontend! Solo se usa en las API Routes de Vercel.
MERCADOPAGO_ACCESS_TOKEN=TEST-XXXXXXXXXXXXXXXXXXXXXX

# Public Key de prueba (test) o producción.
# Solo necesaria si usás MercadoPago Bricks o el SDK de frontend.
# Con Checkout Pro puro (redirect) no es estrictamente necesaria en el frontend.
MERCADOPAGO_PUBLIC_KEY=TEST-XXXXXXXXXXXXXXXXXXXXXX

# ─────────────────────────────────────────────────────────────────
# App URL
# ─────────────────────────────────────────────────────────────────

# URL base de tu aplicación. Usada para construir las back_urls de MercadoPago.
# En Vercel, VERCEL_URL se setea automáticamente (sin protocolo).
# Solo setear APP_URL localmente o si querés forzar un dominio custom.
APP_URL=http://localhost:5173
